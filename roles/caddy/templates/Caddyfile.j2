# File Managed by Ansible
# roles/caddy/templates/Caddyfile.j2

# === GLOBAL CONFIGURATION ===
{
    # --- Directive ordering (required for third-party HTTP handlers) ---
    # These plugins have no built-in order, so they must be declared here to be
    # usable inside `handle` blocks. Order reflects the security pipeline:
    # crowdsec (IP rep) -> rate_limit -> coraza_waf -> appsec -> reverse_proxy
    {% if enable_crowdsec %}
    order crowdsec first
    {% endif %}
    {% if enable_rate_limit | default(true) %}
    order rate_limit before basicauth
    {% endif %}
    {#
    Order directive needed if ANY site has WAF enabled (global or per-site via coraza_mode).
    Check: global enable_coraza_waf, OR any site with coraza_mode set to a non-"off" value.
    #}
    {% set _has_any_waf = enable_coraza_waf | default(false) %}
    {% if not _has_any_waf and enable_wildcard | default(false) %}
        {% for _bd in wildcard_sites | default([]) %}
            {% for _s in _bd.sites | default([]) %}
                {% if _s.coraza_mode is defined and _s.coraza_mode != 'off' %}
                    {% set _has_any_waf = true %}
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}
    {% if not _has_any_waf and not enable_wildcard | default(false) %}
        {% for _s in caddy_sites | default([]) %}
            {% if _s.coraza_mode is defined and _s.coraza_mode != 'off' %}
                {% set _has_any_waf = true %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if enable_crowdsec %}
    order appsec before reverse_proxy
    {% endif %}
    {% if _has_any_waf %}
    order coraza_waf before appsec
    {% endif %}
    {% if enable_rate_limit | default(true) and _has_any_waf %}
    order rate_limit before coraza_waf
    {% endif %}

    {% if enable_crowdsec %}
    crowdsec {
        api_url http://{{ crowdsec_lapi_ip }}:{{ crowdsec_lapi_port }}
        api_key {{ crowdsec_api_key }}
        ticker_interval {{ crowdsec_ticker_interval }}
        appsec_url http://{{ crowdsec_appsec_ip }}:{{ crowdsec_appsec_port }}
        appsec_timeout {{ crowdsec_appsec_timeout | default('10s') }}
    }
    {% endif %}

    {% if enable_cloudflare %}
    acme_dns cloudflare {{ cloudflare_api_token }}
    {% endif %}

    log {
        output stderr
        level INFO
    }
}

{#
Coraza WAF macro — Custom lightweight ruleset replacing the full OWASP CRS.
Instead of loading the entire CRS (hundreds of regex rules causing high CPU and
false positives), we use targeted, efficient rules for real threats.

Modes:
  - minimal:     No ARGS inspection, only method/boundary enforcement
  - recommended: Adds null byte, control char, SQLi, XSS, path traversal
  - moderate:    Adds cmd injection, RFI, SSRF, protocol attacks
  - strict:      Adds full ARGS hardening, SSTI, file upload audit
#}
{% macro coraza_directives(effective_mode, site_name) %}
coraza_waf {
    directives `
        # === CORE CONFIGURATION ===
        SecRuleEngine On
        SecRequestBodyAccess On
        SecResponseBodyAccess Off
        SecDefaultAction "deny,log,status:403"

        # === EARLY STREAMING BYPASSES (all modes) ===
        # WebSocket upgrade bypass
        SecRule REQUEST_HEADERS:Upgrade "@streq websocket" \
            "id:100001,phase:1,nolog,pass,t:none,t:lowercase,ctl:ruleEngine=Off"
        # SSE / event-stream bypass (ntfy subscribe, live logs)
        SecRule REQUEST_HEADERS:Accept "@rx text/event-stream" \
            "id:100002,phase:1,nolog,pass,t:none,ctl:ruleEngine=Off"
        # Socket.IO long-polling bypass
        SecRule REQUEST_URI "@beginsWith /socket.io/" \
            "id:100003,phase:1,nolog,pass,t:none,ctl:ruleEngine=Off"

        {% if effective_mode == 'minimal' %}

        # === MODE: MINIMAL (WebSocket/WebDAV/large uploads) ===
        # Body limits: generous for large uploads (e.g., 500MB for media)
        SecRequestBodyLimit {{ coraza_minimal_body_limit | default(536870912) }}
        SecRequestBodyInMemoryLimit {{ coraza_minimal_body_inmemory_limit | default(134217728) }}
        SecRequestBodyNoFilesLimit {{ coraza_minimal_nofiles_body_limit | default(10485760) }}

        # Allowed methods: broad for WebDAV compatibility
        SecRule REQUEST_METHOD "!@rx ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS|PROPFIND|MKCOL|COPY|MOVE|LOCK|UNLOCK)$" \
            "id:100010,phase:1,deny,log,msg:'Disallowed HTTP method',severity:WARNING"

        # Static file whitelist: skip WAF for all GET static assets
        {% if coraza_file_whitelist_enabled | default(true) %}
        SecRule REQUEST_METHOD "@streq GET" "id:100020,phase:1,pass,nolog,t:none,chain,ctl:ruleEngine=Off"
            SecRule REQUEST_URI "@rx \.({{ coraza_file_whitelist_extensions | default('css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|mp4|webm|ogg|mp3|m3u8|ts|wasm|pdf|txt|csv') }})$" "t:none"
        {% endif %}

        # Block dangerous file uploads
        {% if coraza_block_uploads | default(false) %}
        {% set upload_blocklist = coraza_upload_blocklist | default(['php','phtml','phar','exe','jar','war','dmg','msi','vbs','ps1','sh','bat','com','scr','pif','aspx','cer','cfm','cgi','pl','py','rb','jsp']) %}
        SecRule FILES_NAMES|FILES "@rx \.({{ upload_blocklist | join('|') }})$" \
            "id:100021,phase:2,deny,t:none,t:lowercase,msg:'Blocked dangerous file upload',severity:CRITICAL"
        {% endif %}

        # URI length check: skipped (Coraza regex engine doesn't support {n,} quantifiers).
        # Caddy has its own internal URI limits that prevent buffer overflow attacks.

        {% elif effective_mode == 'recommended' %}

        # === MODE: RECOMMENDED (default, balanced protection) ===
        SecRequestBodyLimit {{ coraza_recommended_body_limit | default(104857600) }}
        SecRequestBodyInMemoryLimit {{ coraza_recommended_body_inmemory_limit | default(1048576) }}
        SecRequestBodyNoFilesLimit {{ coraza_recommended_nofiles_body_limit | default(1048576) }}

        # Allowed methods: standard web methods
        SecRule REQUEST_METHOD "!@rx ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$" \
            "id:100010,phase:1,deny,log,msg:'Disallowed HTTP method',severity:WARNING"

        # Static file whitelist: skip WAF for GET on static assets
        {% if coraza_file_whitelist_enabled | default(true) %}
        SecRule REQUEST_METHOD "@streq GET" "id:100020,phase:1,pass,nolog,t:none,chain,ctl:ruleEngine=Off"
            SecRule REQUEST_URI "@rx \.({{ coraza_file_whitelist_extensions | default('css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|pdf|txt|csv') }})$" "t:none"
        {% endif %}

        # Null byte and control character detection
        SecRule ARGS_NAMES|ARGS "@rx \x00" \
            "id:100030,phase:2,deny,log,msg:'Null byte detected in ARGS',severity:CRITICAL"
        SecRule ARGS_NAMES|ARGS "@rx [\x00-\x08\x0b\x0c\x0e-\x1f\x7f]" \
            "id:100031,phase:2,deny,log,msg:'Control character detected in ARGS',severity:CRITICAL"

        # URI length check: skipped (Coraza regex engine doesn't support {n,} quantifiers).
        # Caddy has its own internal URI limits that prevent buffer overflow attacks.

        # === SQL Injection (lightweight signatures) ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:union\s+select|select\s+.+\s+from|insert\s+into|drop\s+table|delete\s+from|update\s+.+\s+set|create\s+table|alter\s+table|exec\s*\(|execute\s*\(|xp_cmdshell|--\s|#\s|/\*))" \
            "id:100040,phase:2,deny,log,msg:'SQL Injection attempt',severity:CRITICAL"

        # === Cross-Site Scripting (lightweight signatures) ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:<script[^>]*>|javascript\s*:|on\w+\s*=|alert\s*\(|prompt\s*\(|confirm\s*\(|document\.cookie|\.innerHTML|eval\s*\())" \
            "id:100041,phase:2,deny,log,msg:'XSS attempt',severity:CRITICAL"

        # === Path Traversal ===
        SecRule ARGS_NAMES|ARGS "@rx (?:\.\./|\.\.\\|\/\.\.\/|\\\.\.\\)" \
            "id:100042,phase:2,deny,log,msg:'Path traversal attempt',severity:CRITICAL"

        {% elif effective_mode == 'moderate' %}

        # === MODE: MODERATE (balanced CRS-like protection) ===
        SecRequestBodyLimit {{ coraza_moderate_body_limit | default(104857600) }}
        SecRequestBodyInMemoryLimit {{ coraza_moderate_body_inmemory_limit | default(1048576) }}
        SecRequestBodyNoFilesLimit {{ coraza_moderate_nofiles_body_limit | default(1048576) }}

        # Allowed methods
        SecRule REQUEST_METHOD "!@rx ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$" \
            "id:100010,phase:1,deny,log,msg:'Disallowed HTTP method',severity:WARNING"

        # Static file whitelist
        {% if coraza_file_whitelist_enabled | default(true) %}
        SecRule REQUEST_METHOD "@streq GET" "id:100020,phase:1,pass,nolog,t:none,chain,ctl:ruleEngine=Off"
            SecRule REQUEST_URI "@rx \.({{ coraza_file_whitelist_extensions | default('css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|pdf|txt|csv') }})$" "t:none"
        {% endif %}

        # Null byte + control characters
        SecRule ARGS_NAMES|ARGS "@rx \x00" \
            "id:100030,phase:2,deny,log,msg:'Null byte detected in ARGS',severity:CRITICAL"
        SecRule ARGS_NAMES|ARGS "@rx [\x00-\x08\x0b\x0c\x0e-\x1f\x7f]" \
            "id:100031,phase:2,deny,log,msg:'Control character detected in ARGS',severity:CRITICAL"

        # === SQL Injection ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:union\s+select|select\s+.+\s+from|insert\s+into|drop\s+table|delete\s+from|update\s+.+\s+set|create\s+table|alter\s+table|exec\s*\(|execute\s*\(|xp_cmdshell|--\s|#\s|/\*|sleep\s*\(\d+|waitfor\s+delay|benchmark\s*\()|(?:'.*'|\".*\")?\s*or\s+1\s*=\s*1|'.*'.*'.*')" \
            "id:100040,phase:2,deny,log,msg:'SQL Injection attempt',severity:CRITICAL"

        # === Cross-Site Scripting ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:<script[^>]*>|javascript\s*:|on\w+\s*=|alert\s*\(|prompt\s*\(|confirm\s*\(|document\.cookie|\.innerHTML|eval\s*\(|fromCharCode|String\.fromCharCode|<svg|onload\s*=|onerror\s*=|onclick\s*=))" \
            "id:100041,phase:2,deny,log,msg:'XSS attempt',severity:CRITICAL"

        # === Path Traversal ===
        SecRule ARGS_NAMES|ARGS "@rx (?:\.\./|\.\.\\|\/\.\.\/|\\\.\.\\)" \
            "id:100042,phase:2,deny,log,msg:'Path traversal attempt',severity:CRITICAL"

        # === Command Injection ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:;\s*$|`[^`]+`|\$\([^)]+\)|\|\s*$|&&\s*$|>(\s*)?>(\s*)?$|ping\s+-[ntcw]|nslookup\s+|traceroute\s+|wget\s+|curl\s+(?:-o|-O|--output)|bash\s+-c|sh\s+-c|powershell\s+-[ce]|cmd\.exe\s+\/c))" \
            "id:100043,phase:2,deny,log,msg:'Command injection attempt',severity:CRITICAL"

        # === Remote/Local File Inclusion ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:file://|php://|php://filter|php://input|php://stdin|expect://|data://|data:text|ftp://|dict://|gopher://))" \
            "id:100044,phase:2,deny,log,msg:'File inclusion attempt',severity:CRITICAL"

        # === Content-Type enforcement for POST/PUT ===
        SecRule REQUEST_METHOD "@rx ^(POST|PUT|PATCH)$" "id:100045,phase:1,pass,nolog,t:none,chain"
            SecRule REQUEST_HEADERS:Content-Type "!@rx ^(application/x-www-form-urlencoded|multipart/form-data|application/json|application/xml|text/plain|text/xml|application/octet-stream|image/|video/|audio/)" \
                "id:100046,phase:1,deny,log,msg:'Unexpected Content-Type',severity:WARNING"

        {% elif effective_mode == 'strict' %}

        # === MODE: STRICT (maximum security) ===
        SecRequestBodyLimit {{ coraza_strict_body_limit | default(20971520) }}
        SecRequestBodyInMemoryLimit {{ coraza_strict_body_inmemory_limit | default(5242880) }}
        SecRequestBodyNoFilesLimit {{ coraza_strict_nofiles_body_limit | default(1048576) }}

        # Allowed methods: strict
        SecRule REQUEST_METHOD "!@rx ^(GET|HEAD|POST|PUT|DELETE|OPTIONS)$" \
            "id:100010,phase:1,deny,log,msg:'Disallowed HTTP method',severity:WARNING"

        # Static file whitelist (only common static extensions)
        {% if coraza_file_whitelist_enabled | default(true) %}
        SecRule REQUEST_METHOD "@streq GET" "id:100020,phase:1,pass,nolog,t:none,chain,ctl:ruleEngine=Off"
            SecRule REQUEST_URI "@rx \.(css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?|ttf|eot|pdf|txt|csv)$" "t:none"
        {% endif %}

        # Null byte + all control characters
        SecRule ARGS_NAMES|ARGS "@rx \x00" \
            "id:100030,phase:2,deny,log,msg:'Null byte detected in ARGS',severity:CRITICAL"
        SecRule ARGS_NAMES|ARGS "@rx [\x00-\x08\x0b\x0c\x0e-\x1f\x7f]" \
            "id:100031,phase:2,deny,log,msg:'Control character detected in ARGS',severity:CRITICAL"

        # === SQL Injection (aggressive) ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:union\s+select|select\s+.+\s+from|insert\s+into|drop\s+table|delete\s+from|update\s+.+\s+set|create\s+table|alter\s+table|exec\s*\(|execute\s*\(|xp_cmdshell|--\s|#\s|/\*|sleep\s*\(\d+|waitfor\s+delay|benchmark\s*\()|(?:'.*'|\".*\")?\s*or\s+1\s*=\s*1|'.*'.*'.*'|information_schema|sys\.(?:objects|columns|tables)|@@(?:version|servername|hostname))" \
            "id:100040,phase:2,deny,log,msg:'SQL Injection attempt',severity:CRITICAL"

        # === Cross-Site Scripting (aggressive) ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:<script[^>]*>|javascript\s*:|on\w+\s*=|alert\s*\(|prompt\s*\(|confirm\s*\(|document\.cookie|\.innerHTML|eval\s*\(|fromCharCode|String\.fromCharCode|<svg|onload\s*=|onerror\s*=|onclick\s*=|onmouseover\s*=|onfocus\s*=|onblur\s*=|onchange\s*=|onsubmit\s*=|onreset\s*=|onselect\s*=|<img[^>]*onerror|<iframe[^>]*>|<body[^>]*onload|<input[^>]*onfocus|%3Cscript|%3Csvg|%3Ciframe))" \
            "id:100041,phase:2,deny,log,msg:'XSS attempt',severity:CRITICAL"

        # === Path Traversal ===
        SecRule ARGS_NAMES|ARGS "@rx (?:\.\./|\.\.\\|\/\.\.\/|\\\.\.\\)" \
            "id:100042,phase:2,deny,log,msg:'Path traversal attempt',severity:CRITICAL"

        # === Command Injection (aggressive) ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:;\s*$|`[^`]+`|\$\([^)]+\)|\|\s*$|&&\s*$|>(\s*)?>(\s*)?$|ping\s+-[ntcw]|nslookup\s+|traceroute\s+|wget\s+|curl\s+(?:-o|-O|--output)|bash\s+-c|sh\s+-c|powershell\s+-[ce]|cmd\.exe\s+\/c|kill\s+-\d+|chmod\s+[0-7]+|chown\s+|mkfs|dd\s+if=|/dev/(?:null|zero|random|urandom)))" \
            "id:100043,phase:2,deny,log,msg:'Command injection attempt',severity:CRITICAL"

        # === Remote/Local File Inclusion ===
        SecRule ARGS_NAMES|ARGS "@rx (?i:(?:file://|php://|php://filter|php://input|php://stdin|expect://|data://|data:text|ftp://|dict://|gopher://|zlib://|zip://|rar://))" \
            "id:100044,phase:2,deny,log,msg:'File inclusion attempt',severity:CRITICAL"

        # === Template Injection (SSTI) ===
        SecRule ARGS_NAMES|ARGS "@rx (\$\{|<\%|\{\{|%\{|#\{)" \
            "id:100050,phase:2,deny,log,msg:'Template injection marker detected',severity:CRITICAL"

        # === Content-Type enforcement for POST/PUT ===
        SecRule REQUEST_METHOD "@rx ^(POST|PUT|PATCH)$" "id:100045,phase:1,pass,nolog,t:none,chain"
            SecRule REQUEST_HEADERS:Content-Type "!@rx ^(application/x-www-form-urlencoded|multipart/form-data|application/json|application/xml|text/plain|text/xml)" \
                "id:100046,phase:1,deny,log,msg:'Unexpected Content-Type',severity:WARNING"

        # Argument name length limit disabled due to Coraza regex engine limitations.
        # Length validation is implicit through other rules.

        {% endif %}

        # === AUDIT LOG (all modes) ===
        {% if coraza_audit_log_enabled | default(true) %}
        SecAuditEngine RelevantOnly
        SecAuditLogParts ABIJDEFHZ
        SecAuditLog {{ coraza_audit_log_dir | default('/var/log/caddy') }}/modsec_{{ site_name }}.log
        {% else %}
        SecAuditEngine Off
        {% endif %}
    `
}
{%- endmacro %}

# === WILDCARD MODE (supporting multiple base domains) ===
{% if enable_wildcard | default(false) %}

# Process each base domain separately (e.g., *.example.com, *.example.net)
{% for base_domain_config in wildcard_sites | default([]) %}
{% set base_domain = base_domain_config.domain %}
{% set sites = base_domain_config.sites | default([]) %}

{{ base_domain }} {

    # Access logging for this domain
    log {
        format json
        output file {{ wildcard_log_file | default('/var/log/caddy/' + base_domain | replace('.', '_') + '.access.log') }} {
            roll_size {{ wildcard_log_roll_size | default('10mb') }}
            roll_keep {{ wildcard_log_roll_keep | default(10) }}
            roll_keep_for {{ wildcard_log_roll_keep_for | default('36h') }}
        }
    }

    route {
        # === PER-SUBDOMAIN HANDLES ===
        {% for site in sites %}
        # Match exact subdomain for this base domain (e.g., test.example.com)
        @{{ site.name }} host {{ site.subdomain }}.{{ base_domain | replace('*.','') }}
        handle @{{ site.name }} {
            # === WebSocket detection (must be evaluated first) ===
            # WS upgrades bypass rate_limit + Coraza + AppSec (they cannot inspect
            # a WS stream and will refuse the 101). CrowdSec IP block stays (cheap/safe).
            @{{ site.name }}_ws header Upgrade websocket
            handle @{{ site.name }}_ws {
                {% if enable_crowdsec %}
                crowdsec
                {% endif %}
                reverse_proxy localhost:{{ site.port }} {
                    header_up X-Request-ID {http.request.id}
                    {% if site.stream | default(false) %}
                    flush_interval -1
                    {% endif %}
                }
            }
            # === Standard traffic: full security pipeline ===
            handle {
                {% if enable_crowdsec %}
                # 1. CrowdSec: blocks known bad IPs (cheapest check first)
                crowdsec
                {% endif %}
                {% if enable_rate_limit | default(true) %}
                # 2. Rate limiting: Prevent brute force and DDoS (also cheap)
                rate_limit {
                    zone {{ site.name | default(site.subdomain | replace('.', '_')) }} {
                        key "{http.request.remote.ip}"
                        window {{ site.rate_limit_window | default('1m') }}
                        events {{ site.rate_limit_events | default(500) }}
                    }
                }
                {% endif %}

                {% set site_coraza_mode = site.coraza_mode | default(none) %}
                {% if site_coraza_mode is not none and site_coraza_mode != 'off' %}
                    {% set effective_coraza_mode = site_coraza_mode %}
                    {% set site_has_waf = true %}
                {% elif site_coraza_mode is not none and site_coraza_mode == 'off' %}
                    {% set site_has_waf = false %}
                {% else %}
                    {% set site_has_waf = enable_coraza_waf | default(false) %}
                    {% set effective_coraza_mode = coraza_mode_default | default('recommended') %}
                {% endif %}
                {% if site_has_waf %}
                # 3. Coraza WAF: lightweight rules, low CPU
                {{ coraza_directives(effective_coraza_mode, site.name) }}
                {% endif %}

                {% if enable_crowdsec and not site.disable_appsec | default(false) and not site.stream | default(false) %}
                # 4. CrowdSec AppSec: deep behavior/application inspection (most expensive - runs last)
                # Auto-disabled for stream: true sites (media streaming has binary payloads
                # that AppSec cannot inspect, causing timeouts and 100% CPU).
                appsec
                {% endif %}

                # 5. Reverse Proxy: Only clean, encrypted traffic reaches this point
                {% if site.enable_forward is defined and site.enable_forward and site.forward_path is defined %}
                # Route specific paths to different backends when configured
                @forward_path path {{ site.forward_path }}*
                reverse_proxy @forward_path localhost:{{ site.forward_path_port | default(site.port) }} {
                    header_up X-Forwarded-For {{ site.forward_ip }}
                    {% if site.stream | default(false) %}
                    flush_interval -1
                    {% endif %}
                    {% if site.proxy_timeout is defined %}
                    transport http {
                        response_header_timeout {{ site.proxy_timeout }}
                        dial_timeout {{ site.proxy_timeout }}
                    }
                    {% endif %}
                }
                {% endif %}

                # Default proxy for all other paths
                reverse_proxy localhost:{{ site.port }} {
                    header_up X-Request-ID {http.request.id}
                    {% if site.stream | default(false) %}
                    flush_interval -1
                    {% endif %}
                    {% if site.proxy_timeout is defined %}
                    transport http {
                        response_header_timeout {{ site.proxy_timeout }}
                        dial_timeout {{ site.proxy_timeout }}
                    }
                    {% endif %}
                }
            }
            # Security headers (applies to this subdomain)
            header {
                X-Frame-Options "SAMEORIGIN"
                X-Content-Type-Options "nosniff"
                X-XSS-Protection "1; mode=block"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
            }

            # Caching headers for static media/metadata to reduce requests
            # Use site.cache_paths to customize per site (Jellyfin defaults if not set)
            {% set cache_paths = site.cache_paths | default('/Items/* /Images/* /web/* *.js *.css *.jpg *.png *.gif') %}
            @static_assets path {{ cache_paths }}
            header @static_assets Cache-Control "public, max-age=86400"
            header @static_assets ETag {http.response.header.ETag}
        }
        {% endfor %}

        # Fallback for unmatched subdomains
        handle {
            respond "Service not found" 404
        }
    }
}

{% endfor %}

# === TRADITIONAL MODE (NO Wildcard) ===
{% else %}

{% for site in caddy_sites %}
{{ site.domain }} {
    route {
        # === WebSocket detection (must be evaluated first) ===
        # WS upgrades bypass rate_limit + Coraza + AppSec (they cannot inspect
        # a WS stream and will refuse the 101). CrowdSec IP block stays (cheap/safe).
        @websocket header Upgrade websocket
        handle @websocket {
            {% if enable_crowdsec %}
            crowdsec
            {% endif %}
            reverse_proxy localhost:{{ site.local_port }} {
                header_up X-Request-ID {http.request.id}
                {% if site.stream | default(false) %}
                flush_interval -1
                {% endif %}
            }
        }
        # === Standard traffic: full security pipeline ===
        handle {
            {% if enable_crowdsec %}
            # 1. CrowdSec: blocks known bad IPs (cheapest check first)
            crowdsec
            {% endif %}
            {% if enable_rate_limit | default(true) %}
            # 2. Rate limiting: Prevent brute force and DDoS (also cheap)
            rate_limit {
                zone {{ site.name | default(site.domain | replace('.', '_')) }} {
                    key "{http.request.remote.ip}"
                    window {{ site.rate_limit_window | default('1m') }}
                    events {{ site.rate_limit_events | default(500) }}
                }
            }
            {% endif %}

            {% set site_coraza_mode = site.coraza_mode | default(none) %}
            {% if site_coraza_mode is not none and site_coraza_mode != 'off' %}
                {% set effective_coraza_mode = site_coraza_mode %}
                {% set site_has_waf = true %}
            {% elif site_coraza_mode is not none and site_coraza_mode == 'off' %}
                {% set site_has_waf = false %}
            {% else %}
                {% set site_has_waf = enable_coraza_waf | default(false) %}
                {% set effective_coraza_mode = coraza_mode_default | default('recommended') %}
            {% endif %}
            {% if site_has_waf %}
            # 3. Coraza WAF: lightweight rules, low CPU
            {{ coraza_directives(effective_coraza_mode, site.name) }}
            {% endif %}
            {% if enable_crowdsec and not site.disable_appsec | default(false) and not site.stream | default(false) %}
            # 4. CrowdSec AppSec: deep behavior/application inspection (most expensive - runs last)
            # Auto-disabled for stream: true sites (media streaming has binary payloads
            # that AppSec cannot inspect, causing timeouts and 100% CPU).
            appsec
            {% endif %}
            # 5. Reverse Proxy
            {% if site.enable_forward is defined and site.enable_forward and site.forward_path is defined %}
            @forward_path path {{ site.forward_path }}*
            reverse_proxy @forward_path localhost:{{ site.forward_path_port | default(site.local_port) }} {
                header_up X-Forwarded-For {{ site.forward_ip }}
                {% if site.stream | default(false) %}
                flush_interval -1
                {% endif %}
                {% if site.proxy_timeout is defined %}
                transport http {
                    response_header_timeout {{ site.proxy_timeout }}
                    dial_timeout {{ site.proxy_timeout }}
                }
                {% endif %}
            }
            {% endif %}
            reverse_proxy localhost:{{ site.local_port }} {
                header_up X-Request-ID {http.request.id}
                {% if site.stream | default(false) %}
                flush_interval -1
                {% endif %}
                {% if site.proxy_timeout is defined %}
                transport http {
                    response_header_timeout {{ site.proxy_timeout }}
                    dial_timeout {{ site.proxy_timeout }}
                }
                {% endif %}
            }
        }
    }
    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    }

    # Caching headers for static media/metadata to reduce requests
    # Use site.cache_paths to customize per site (Jellyfin defaults if not set)
    {% set cache_paths = site.cache_paths | default('/Items/* /Images/* /web/* *.js *.css *.jpg *.png *.gif') %}
    @static_assets path {{ cache_paths }}
    header @static_assets Cache-Control "public, max-age=86400"
    header @static_assets ETag {http.response.header.ETag}

    # Access logging for this site
    log {
        format json
        output file {{ site.log_file | default('/var/log/caddy/' + site.name + '.access.log') }} {
            roll_size {{ site.log_roll_size | default('10mb') }}
            roll_keep {{ site.log_roll_keep | default(10) }}
            roll_keep_for {{ site.log_roll_keep_for | default('36h') }}
        }
    }
}

{% endfor %}
{% endif %}
