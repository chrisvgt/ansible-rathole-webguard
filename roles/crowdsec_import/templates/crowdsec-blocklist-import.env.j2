# CrowdSec Blocklist Import - Environment Configuration
# Generated by Ansible

# =============================================================================
# Required Settings
# =============================================================================

# CrowdSec LAPI URL (your CrowdSec instance)
CROWDSEC_LAPI_URL=http://{{ crowdsec_import_blocklist_lapi_url }}

# CrowdSec LAPI Key (for reading existing decisions)
# Generate with: cscli bouncers add blocklist-import -o raw
CROWDSEC_LAPI_KEY={{ crowdsec_import_blocklist_bouncer_key }}

# Machine credentials (required for writing decisions)
# Option 1: Use existing machine credentials from /etc/crowdsec/local_api_credentials.yaml
# Option 2: Create a new machine: cscli machines add blocklist-import --password 'YourSecurePassword'
CROWDSEC_MACHINE_ID={{ crowdsec_import_blocklist_machine_id }}
CROWDSEC_MACHINE_PASSWORD={{ crowdsec_import_blocklist_machine_password }}

# Optional: trust bundle used to verify the HTTPS certificate served by LAPI.
# This does not authenticate the importer to LAPI.
# CROWDSEC_LAPI_CA_CERT_PATH=/certs/crowdsec_lapi.pem

# Optional: agent client certificate for JWT/write authentication.
# AGENT_CERT_PATH and AGENT_KEY_PATH must be set together.
# CROWDSEC_LAPI_AGENT_CERT_PATH=/certs/blocklist-import-agent.pem
# CROWDSEC_LAPI_AGENT_KEY_PATH=/certs/blocklist-import-agent-key.pem

# Optional: bouncer client certificate for reading existing decisions.
# BOUNCER_CERT_PATH and BOUNCER_KEY_PATH must be set together.
# CROWDSEC_LAPI_BOUNCER_CERT_PATH=/certs/blocklist-import-bouncer.pem
# CROWDSEC_LAPI_BOUNCER_KEY_PATH=/certs/blocklist-import-bouncer-key.pem

# =============================================================================
# Decision Settings
# =============================================================================

# How long decisions last (refresh daily with 24h)
DECISION_DURATION={{ crowdsec_import_blocklist_decision_duration }}

# Decision reason (visible in cscli decisions list)
DECISION_REASON={{ crowdsec_import_blocklist_decision_reason }}

# Decision type (ban, captcha, throttle)
DECISION_TYPE={{ crowdsec_import_blocklist_decision_type }}

# Decision origin (for filtering)
DECISION_ORIGIN={{ crowdsec_import_blocklist_decision_origin }}

# Decision scenario (for filtering)
DECISION_SCENARIO={{ crowdsec_import_blocklist_decision_scenario }}

# Allowlist - comma-separated IPs and/or CIDR ranges to exclude from bans
# Supports both individual IPs and CIDR notation for range matching
# Examples:
#   ALLOWLIST=1.2.3.4,5.6.7.8                    # Individual IPs
#   ALLOWLIST=140.82.112.0/20,185.199.108.0/22   # CIDR ranges
#   ALLOWLIST=1.2.3.4,140.82.112.0/20            # Mixed
ALLOWLIST={{ crowdsec_import_blocklist_allowlist }}

# Provider allowlists - auto-fetch IP ranges from well-known providers
# ALLOWLIST_GITHUB: Fetches GitHub's IP ranges from https://api.github.com/meta
#   Covers: git, web, api, hooks, and actions IP ranges
#   Falls back to hardcoded ranges if API is unreachable
ALLOWLIST_GITHUB={{ crowdsec_import_blocklist_allowlist_github | lower }}

LOG_TIMESTAMPS=true

# =============================================================================
# Processing Settings
# =============================================================================

# Number of IPs to import per batch (memory vs. speed tradeoff)
BATCH_SIZE={{ crowdsec_import_blocklist_batch_size }}

# Timeout for fetching each blocklist (seconds)
FETCH_TIMEOUT={{ crowdsec_import_blocklist_fetch_timeout | default(60) }}

# Max retries for failed HTTP requests
MAX_RETRIES={{ crowdsec_import_blocklist_max_retries | default(3) }}

# Dry run (set to true to test without importing)
DRY_RUN={{ crowdsec_import_blocklist_dry_run | lower }}

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL={{ crowdsec_import_blocklist_log_level }}

# =============================================================================
# Telemetry
# =============================================================================

# Anonymous usage telemetry (set to false to disable)
TELEMETRY_ENABLED={{ crowdsec_import_blocklist_telemetry_enabled | lower }}

# =============================================================================
# Blocklist Enables (all true by default)
# Set to false to disable specific blocklists
# =============================================================================

# Aggregated threat intel (IPs on 3+ blocklists)
ENABLE_IPSUM={{ crowdsec_import_blocklist_enable_ipsum | lower }}

# Spamhaus DROP (known hijacked netblocks)
ENABLE_SPAMHAUS={{ crowdsec_import_blocklist_enable_spamhaus | lower }}

# Blocklist.de (all/ssh/apache/mail)
ENABLE_BLOCKLIST_DE={{ crowdsec_import_blocklist_enable_blocklist_de | lower }}

# Firehol level1 and level2
ENABLE_FIREHOL={{ crowdsec_import_blocklist_enable_firehol | lower }}

# Abuse.ch (Feodo, URLhaus)
ENABLE_ABUSE_CH={{ crowdsec_import_blocklist_enable_abuse_ch | lower }}

# Emerging Threats compromised IPs
ENABLE_EMERGING_THREATS={{ crowdsec_import_blocklist_enable_emerging_threats | lower }}

# Binary Defense ban list
ENABLE_BINARY_DEFENSE={{ crowdsec_import_blocklist_enable_binary_defense | lower }}

# Bruteforce Blocker
ENABLE_BRUTEFORCE_BLOCKER={{ crowdsec_import_blocklist_enable_bruteforce_blocker | lower }}

# DShield top attackers
ENABLE_DSHIELD={{ crowdsec_import_blocklist_enable_dshield | lower }}

# CI Army bad reputation
ENABLE_CI_ARMY={{ crowdsec_import_blocklist_enable_ci_army | lower }}

# Botvrij botnet C2
ENABLE_BOTVRIJ={{ crowdsec_import_blocklist_enable_botvrij | lower }}

# GreenSnow attacker IPs
ENABLE_GREENSNOW={{ crowdsec_import_blocklist_enable_greensnow | lower }}

# StopForumSpam toxic IPs
ENABLE_STOPFORUMSPAM={{ crowdsec_import_blocklist_enable_stopforumspam | lower }}

# Tor exit nodes (may cause false positives for Tor users)
ENABLE_TOR={{ crowdsec_import_blocklist_enable_tor | lower }}

# Scanner IPs (Shodan, Censys)
ENABLE_SCANNERS={{ crowdsec_import_blocklist_enable_scanners | lower }}

# AbuseIPDB public mirror by @borestad (no API key required)
# Set ABUSEIPDB_API_KEY below for direct API access (optional: higher rate limits, fresher data)
ENABLE_ABUSE_IPDB={{ crowdsec_import_blocklist_enable_abuse_ipdb | lower }}

# AbuseIPDB direct API (optional — requires free account at abuseipdb.com)
# Free tier: 5 blacklist checks per day
# ABUSEIPDB_API_KEY=your_api_key_here
# ABUSEIPDB_API_KEY_FILE=your_api_key_file_path_here
# ABUSEIPDB_MIN_CONFIDENCE=90
# ABUSEIPDB_LIMIT=10000

ENABLE_CYBERCRIME_TRACKER={{ crowdsec_import_blocklist_enable_cybercrime_tracker | lower }}

ENABLE_MONTY_SECURITY_C2={{ crowdsec_import_blocklist_enable_monty_security_c2 | lower }}

ENABLE_VXVAULT={{ crowdsec_import_blocklist_enable_vxvault | lower }}

# =============================================================================
# Output Settings
# =============================================================================

# Output file path (for file-based output)
OUTPUT_FILE={{ crowdsec_import_blocklist_output_file }}
