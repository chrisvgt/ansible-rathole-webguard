# File Managed by Ansible
# roles/crowdsec/templates/login-bf.yaml.j2
# Repeated failed POSTs to login-like paths, read from the Caddy access log,
# ban the client IP. Covers apps that answer a wrong password with 400, which
# the stock scenarios (401/403 only) miss.

type: leaky
name: local/login-bf
description: "Failed logins on login-like paths"
filter: {{ ("evt.Meta.log_type == 'http_access-log' && evt.Meta.http_verb == 'POST'"
            ~ " && Split(evt.Meta.http_path, \"?\")[0] matches " ~ crowdsec_login_path_pattern | to_json
            ~ " && evt.Meta.http_status in " ~ crowdsec_login_fail_status | map('string') | list | to_json) | to_json }}
groupby: evt.Meta.source_ip
capacity: {{ crowdsec_login_bf_capacity }}
leakspeed: {{ crowdsec_login_bf_leakspeed | to_json }}
blackhole: 1m
labels:
  service: http
  behavior: "http:bruteforce"
  label: "HTTP login brute force"
  classification:
    - attack.T1110
  confidence: 3
  spoofable: 0
  remediation: true
