# File Managed by Ansible
# roles/crowdsec/templates/rathole-logs.yaml.j2
# Failed handshakes on the Rathole server port, e.g.
# ... rathole::server: Handshake from 203.0.113.5 failed: Failed to do transport handshake: ...
onsuccess: next_stage
filter: "evt.Parsed.program == 'rathole'"
name: local/rathole-logs
description: "Parse failed handshakes on the Rathole server port"
grok:
  pattern: 'Handshake from %{IP:source_ip} failed: %{GREEDYDATA:reason}'
  apply_on: message
statics:
  - meta: log_type
    value: rathole_failed_handshake
  - meta: service
    value: rathole
  - meta: source_ip
    expression: evt.Parsed.source_ip
  - meta: message
    expression: evt.Parsed.reason
