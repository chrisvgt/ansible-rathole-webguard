# File Managed by Ansible
# roles/crowdsec/templates/rathole-bf.yaml.j2
# Repeated failed handshakes on the Rathole server port ban the IP: wrong keys,
# other protocols, scanners. Not counted: timeouts (own client on a slow line)
# and errors after a successful Noise handshake ("failed the authentication",
# "No such a service"). Those need the server's key, so they come from the own
# client while server and client configs differ (token rotation, removed service).
type: leaky
name: local/rathole-bf
description: "Failed handshakes on the Rathole server port"
filter: "evt.Meta.log_type == 'rathole_failed_handshake' && !(evt.Meta.message matches '(?i)timeout|failed the authentication|no such a service')"
groupby: evt.Meta.source_ip
capacity: {{ crowdsec_rathole_bf_capacity }}
leakspeed: {{ crowdsec_rathole_bf_leakspeed | to_json }}
blackhole: 5m
labels:
  service: rathole
  behavior: "tcp:bruteforce"
  label: "Rathole handshake brute force"
  classification:
    - attack.T1110
  confidence: 3
  spoofable: 0
  remediation: true
