extends: default

# CI and pre-commit run `yamllint -s`: warnings fail as well, so every rule is enforced.
rules:
  indentation:
    indent-sequences: consistent

  # Long Jinja expressions and regexes are common in this repo
  line-length:
    max: 300
    allow-non-breakable-words: true

  truthy:
    allowed-values: ["true", "false"]

  # Align comment spacing with Prettier (1 space before inline comments)
  comments:
    min-spaces-from-content: 1

  # Required by ansible-lint for a compatible yamllint configuration
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

  # Disable YAML doc start marker (---) requirement
  document-start: disable
